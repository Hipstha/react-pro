# ============================
# Dependencias (a cualquier nivel de profundidad)
# ============================
node_modules/
**/node_modules/
jspm_packages/
bower_components/
 
# ============================
# Package managers / lockfiles alternos y cache
# ============================
.npm/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*
.pnpm-store/
.yarn-integrity
 
# ============================
# Builds / outputs de bundlers
# ============================
dist/
build/
out/
.next/
.nuxt/
.turbo/
.parcel-cache/
.cache/
storybook-static/
.vercel/
.netlify/
 
# ============================
# Testing / coverage
# ============================
coverage/
.nyc_output/
*.lcov
 
# ============================
# Logs y debug
# ============================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
 
# ============================
# Variables de entorno (nunca commitear secretos)
# ============================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
 
# ============================
# Editor / IDE
# ============================
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
 
# ============================
# Sistema operativo
# ============================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
 
# ============================
# TypeScript
# ============================
*.tsbuildinfo
next-env.d.ts
 
# ============================
# PWA / Workbox (generados en build)
# ============================
**/public/sw.js
**/public/workbox-*.js
**/public/worker-*.js
**/public/sw.js.map
**/public/workbox-*.js.map
 
# ============================
# Misceláneo
# ============================
*.tgz
.eslintcache
.stylelintcache
*.pid
*.seed
*.pid.lock